{
  "name": "polendina",
  "version": "3.3.4",
  "description": "Non-UI browser testing for JavaScript libraries from the command-line",
  "main": "polendina.js",
  "type": "module",
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "glob": "^13.0.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "puppeteer": "^25.0.4",
    "raw-loader": "^4.0.2",
    "readable-stream": "^4.5.2",
    "rimraf": "^6.0.1",
    "st": "^4.0.2",
    "stream-browserify": "^3.0.0",
    "strip-ansi": "^7.1.0",
    "webpack": "^5.95.0",
    "webpack-merge": "^6.0.1",
    "yargs": "^18.0.0"
  },
  "bin": {
    "polendina": "./polendina-cli.js",
    "polendina-node": "./polendina-node-cli.js"
  },
  "scripts": {
    "lint": "standard",
    "test:run": "npx --yes mocha --require test/setup.js test/test-*.js",
    "test": "npm run lint && npm run test:run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rvagg/polendina.git"
  },
  "keywords": [
    "puppeteer",
    "chrome",
    "chromium",
    "mocha",
    "tape",
    "tests",
    "testing",
    "test"
  ],
  "author": "Rod <rod@vagg.org> (http://r.va.gg/)",
  "license": "Apache-2.0",
  "devDependencies": {
    "standard": "^17.1.2"
  }
}
